#!/usr/bin/env bash
set -e

# Gradescope only runs this file. It places the student's uploaded files in
# /autograder/submission and expects a results file at
# /autograder/results/results.json.

# TODO: rename TODO_SUBMISSION_NAME.py to match the filename students submit
cp /autograder/submission/TODO_SUBMISSION_NAME.py /autograder/source/TODO_SUBMISSION_NAME.py
cd /autograder/source

# `|| true`: pytest exits non-zero when a test fails, which would otherwise
# stop this script (set -e) before results.json ever gets written.
python3 -m pytest tests/ --junitxml=/tmp/report.xml -q || true

python3 gradescope_json.py /tmp/report.xml /autograder/results/results.json
